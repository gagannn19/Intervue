# Base URL of the Intervue backend API.
VITE_API_URL="http://localhost:4000/api"

# Firebase web app config — from Firebase Console > Project settings >
# General > Your apps > SDK setup and configuration (the "Config" snippet).
# These ship in the client bundle by design; they are not secrets, but keep
# them here so each environment points at its own Firebase project.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
